<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gbos.hub"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Phone Hub"
        android:icon="@drawable/ic_phone_hub"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="Phone Hub Link"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HubWidgetProvider"
            android:label="Phone Hub"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.gbos.hub.ACTION_RECONNECT" />
                <action android:name="com.gbos.hub.ACTION_LAUNCH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_info" />
        </receiver>

    </application>
</manifest>
