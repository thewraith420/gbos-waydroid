<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vendor.google.desktop.serviceability"
    android:versionCode="2"
    android:versionName="1.1-waydroid-stub">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <!-- The client library declares these in its own manifests; defining them as normal-level lets
         those apps be granted them without needing the real vendor signature. -->
    <permission android:name="vendor.google.desktop.permission.BIND_SERVICEABILITY_SERVICE_INTERNAL"
        android:protectionLevel="normal" />
    <permission android:name="vendor.google.desktop.permission.BIND_SERVICEABILITY_SERVICE_SIGNATURE"
        android:protectionLevel="normal" />
    <permission android:name="vendor.google.desktop.permission.WRITE_VPD_ACTIVATE_DATE"
        android:protectionLevel="normal" />

    <application
        android:label="Serviceability (Waydroid stub)"
        android:allowBackup="false"
        android:hasCode="true">
        <service
            android:name="vendor.google.desktop.serviceability.VendorServiceabilityService"
            android:exported="true" />
    </application>
</manifest>
