# ~/.config/gbos/gbos.env  (KEY=VALUE lines; read by the Phone Hub scripts and daemons)
# Everything is optional: the defaults are discovered at run time. Uncomment only to override.

# adb address of the Waydroid container. Default: asked from `waydroid status` (Waydroid hands it out by DHCP).
#GB_CONTAINER=192.168.240.112:5555

# Host network interface the phone is reached through. Default: the interface of the default route.
#GB_LAN_IFACE=wlp3s0

# Waydroid's host-side bridge address (the link daemon listens here).
#GB_BRIDGE_IP=192.168.240.1

# Pin the phone's address. Ignored automatically when it is not on this host's current subnet.
#GB_PHONE_IP=192.168.1.50

# adb key authorized in the container, if it is not ~/.android/adbkey.
#GB_ADB_KEY=/path/to/adbkey

# Extra addresses allowed to inject input into the phone (comma separated). The container's own addresses,
# this host and loopback are always allowed.
#GB_INPUT_ALLOW_EXTRA=

# Where locks, pid files, logs and the phone-agent token live. Default: $XDG_RUNTIME_DIR/gbos (private, tmpfs).
#GB_RUN=
# Persistent cache (last phone address, downloaded frida-server). Default: ~/.cache/gbos
#GB_STATE=
