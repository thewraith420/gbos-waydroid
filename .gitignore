# Build artifacts — the installer builds and signs the apps; never commit outputs
android/*/build/
**/build/
*.apk
*.dex

# Signing keys and secrets — never commit (svc_stub_apk generates its own at build time)
*.p12
*.jks
*.keystore
**/adbkey
**/adbkey.pub
**/*token*

# Python
__pycache__/
*.pyc

# Local scratch / state
*.log
.verified
*.orig
